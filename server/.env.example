# Port used by the Express API
PORT=5000

# Port exposed by the embedded MongoDB (npm run db:show / db:shell)
MONGODB_PORT=27018

# Optional: use your own MongoDB instead of the embedded database
# MONGODB_URI=mongodb://127.0.0.1:27017/pharma_simple

# Optional: reuse an already downloaded MongoDB binary
# MONGOMS_DOWNLOAD_DIR=C:\path\to\mongodb-binaries
